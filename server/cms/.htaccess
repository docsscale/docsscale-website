# cms.docsscale.com: the address of the editing screen (docs/COMPLETION-PLAN.md,
# section 6). Until the editing app is installed here, the address answers
# nothing at all. The app replaces this file with its own sign-in.

# 1. Closed to everyone.
Require all denied

# 2. Never indexed, even if a link leaks.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
