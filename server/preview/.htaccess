# preview.docsscale.com: the private copy of the site that editors check before
# a change goes live (docs/COMPLETION-PLAN.md, section 5, item 7). Lives in its
# own folder on the server, apart from the live site.

# 1. Password protection: the same login as staging (stored outside any web root).
AuthType Basic
AuthName "DocsScale preview"
AuthUserFile /home/u145389112/domains/docsscale.com/private-staging/.htpasswd
Require valid-user

# 2. Never indexed, even if a link leaks.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# 3. Never kept in a cache: the preview must show the latest save at once, in
#    the browser and in Hostinger's own cache in front of the site. (The site's
#    fingerprinted files under /_next/static/ keep their long cache; their names
#    change when their content does.)
<IfModule mod_headers.c>
    <FilesMatch "\.(html|txt|xml|json)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set CDN-Cache-Control "no-store"
    </FilesMatch>
</IfModule>
