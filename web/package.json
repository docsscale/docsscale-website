{
  "name": "docsscale-web",
  "private": true,
  "description": "DocsScale website (Next.js App Router, static export to out/)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "sitemap:check": "node scripts/generate-sitemap.mjs --check",
    "check:site": "node scripts/site-checks.mjs",
    "prebuild": "node scripts/optimise-uploads.mjs",
    "uploads": "node scripts/optimise-uploads.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "libphonenumber-js": "1.13.14",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@keystatic/core": "0.6.9",
    "@markdoc/markdoc": "0.5.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
