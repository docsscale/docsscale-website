{
  "name": "docsscale",
  "private": true,
  "description": "DocsScale website: Next.js frontend (web/), PHP lead handler (server/), tests and docs.",
  "scripts": {
    "test:server": "bash tests/server/lead-handler.sh && bash tests/server/lead-digest.sh",
    "visual:baseline": "node tests/visual/capture.mjs --out tests/visual/baseline",
    "visual:candidate": "node tests/visual/capture.mjs --site web/out --out tests/visual/candidate",
    "visual:compare": "node tests/visual/compare.mjs",
    "test:e2e": "node tests/visual/interactions.mjs && node tests/visual/nav-behaviour.mjs && node tests/visual/form-a11y.mjs",
    "test:redirects": "bash tests/server/redirects.sh",
    "visual:approve": "node scripts/approve-visual.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0"
  }
}
